# --- App ---
# Public origin of the site; used to build email verification and password-reset links.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Required. Never commit a real URL.
DATABASE_URL=

# --- Auth.js ---
# Generate: openssl rand -base64 32   (or any 32-byte base64/hex value)
AUTH_SECRET=

# --- Vault / credential encryption ---
# AES-256-GCM key: exactly 32 bytes, hex (64 chars) or base64. Keep this out of the database
# and out of source control. Rotating it makes existing vault items unreadable.
VAULT_ENCRYPTION_KEY=

# --- Cloudinary (server-side only; never add NEXT_PUBLIC_ to the secret) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix for uploads. Defaults to "portfolio".
CLOUDINARY_FOLDER=

# --- Email delivery (verification + password reset links) ---
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=false
EMAIL_FROM=

# --- Owner bootstrap (seed only; consumed once, then remove from the environment) ---
#OWNER_EMAIL=
#OWNER_NAME=
#OWNER_USERNAME=
#OWNER_PASSWORD=

# --- Video downloader tool (optional; leave blank to keep the tool hidden) ---
YTDLP_API_URL=
YTDLP_API_KEY=
